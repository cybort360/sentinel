# Copy to .env and fill in. Never commit .env (see .gitignore).

# Qwen Cloud / Alibaba Model Studio (OpenAI-compatible endpoint)
QWEN_API_KEY=
# Region-locked: the key only works against its own region's URL.
#   Singapore / International (most hackathon vouchers):
#     https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   Beijing / China mainland:
#     https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_YIELD=qwen3-coder-plus
# Adversary: "thinking" is a *mode* on qwen3-max (enable_thinking request param),
# not a standalone model id. Use qwen3-max for a first live smoke test; wiring
# true thinking-mode (extra_body + stream) is a follow-up. Confirm reachability
# with `uv run python -m sentinel.agents.qwen_client`.
QWEN_MODEL_ADVERSARY=qwen3-max
QWEN_MODEL_ARBITRATOR=qwen3-max
QWEN_MODEL_LESSONS=qwen-plus
QWEN_MODEL_BASELINE=qwen3-max

# SimulationMCP
ANVIL_FORK_URL=               # public mainnet RPC to fork from (read-only)
ANVIL_HOST=127.0.0.1
ANVIL_PORT=8545

# MemoryMCP
MEMORY_DB_PATH=./data/memory.db

# Orchestration
MAX_ITERATIONS=4
MEMORY_TOP_K=3

# MCP transport (architecture.md §5, §15)
# Local dev + the unit/integration harness drive each server over stdio (the
# default). The docker-compose stack sets these per service to bring each server
# up as a networked FastMCP endpoint instead. Leave unset for stdio.
# SENTINEL_MCP_TRANSPORT=stdio   # stdio | streamable-http | sse
# SENTINEL_MCP_HOST=0.0.0.0      # bind host for networked transports
# SENTINEL_MCP_PORT=8000         # bind port for networked transports

# Web UI (architecture.md §18) — the `make web` / compose `web` service.
# SENTINEL_WEB_HOST=0.0.0.0
# SENTINEL_WEB_PORT=8088

# Deployment (architecture.md §15) — used by deploy/deploy.sh for a remote ECS
# host. Leave unset to build/run the compose stack locally.
# ECS_HOST=                      # user@alibaba-ecs-public-ip (SSH target)
# ECS_REMOTE_DIR=~/sentinel      # path on the ECS host to sync the repo into
